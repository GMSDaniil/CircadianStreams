          "editorMode": "code",
          "rawSql": "SELECT window_end AS time, is_stability AS \"IS\", iv_variab AS \"IV\" FROM circadian_metrics WHERE method = 'isiv' AND patient_id = '$patient' AND signal_type = '$signal' AND $__timeFilter(window_end) ORDER BY 1"
