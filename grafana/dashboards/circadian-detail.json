    {
      "id": 6,
      "type": "table",
      "title": "Latest Cosinor per patient / signal",
      "datasource": { "uid": "circadian-postgres" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 16 },
      "options": { "showHeader": true },
      "targets": [
        {
          "refId": "A",
          "datasource": { "uid": "circadian-postgres" },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT DISTINCT ON (patient_id, signal_type) patient_id, signal_type, round(amplitude::numeric, 2) AS amplitude, round(r2::numeric, 3) AS r2, window_end FROM circadian_metrics WHERE method = 'cosinor' ORDER BY patient_id, signal_type, window_end DESC"
